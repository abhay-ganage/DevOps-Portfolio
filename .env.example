# EmailJS Configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to Git.
#
# How to get these values:
# 1. Sign up at https://www.emailjs.com/
# 2. Add a Gmail "Email Service" → copy the Service ID below
# 3. Create an Email Template → copy the Template ID below
# 4. Go to Account → API Keys → copy your Public Key below
#
# Template variables expected (match your EmailJS template):
#   {{from_name}}   — sender's name
#   {{from_email}}  — sender's email
#   {{subject}}     — message subject
#   {{message}}     — message body
#   {{reply_to}}    — set to sender's email for easy reply

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
